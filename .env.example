# --- Database (required) -----------------------------------------------------
# Postgres (local, Neon, Supabase, ...):
DATABASE_URL=postgresql://user:password@localhost:5432/aetherops
# ...or the embedded, zero-install local database (stored in ./.data, gitignored):
# DATABASE_URL=pglite:./.data/pglite
#
# TLS: by default the connection string's sslmode decides and certificates are verified.
# DATABASE_SSL=disable | no-verify   (no-verify skips certificate checks; avoid in production)
# DATABASE_POOL_MAX=10

# --- AI engine (optional) -----------------------------------------------------
# Without these, AetherOps runs fully offline on the deterministic engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# AETHEROPS_AI_CHUNK_TOKENS=6000     # input-token budget per chunk
# AETHEROPS_AI_MAX_CHUNKS=8          # chunks analyzed per file (larger files are reported as partial coverage)
# AETHEROPS_AI_DEADLINE_MS=55000     # total time budget per file analysis

# --- Local-first filesystem mode ----------------------------------------------
# Directories the server may read, write and git-commit in. Separate entries with ';' on Windows, ':' elsewhere.
# Leave unset to disable server filesystem access (browser folder picker only). Always disabled on Vercel.
# AETHEROPS_ALLOWED_ROOTS=C:\Users\you\Desktop
# AETHEROPS_MAX_FILES=5000
# Extra Host names allowed to trigger filesystem operations (loopback is always allowed):
# AETHEROPS_TRUSTED_HOSTS=

# --- Sample project ---------------------------------------------------------------
# A built-in sample project (three files with real defects) is created on first visit.
# AETHEROPS_DEMO=off
